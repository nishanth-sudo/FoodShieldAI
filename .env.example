# FoodShield AI Environment Configuration
# Copy to .env and fill in your values

# App
FOODSHIELD_APP_NAME=FoodShield AI
FOODSHIELD_APP_VERSION=0.1.0
FOODSHIELD_DEBUG=false

# Database (PostgreSQL)
FOODSHIELD_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/foodshield

# Redis
FOODSHIELD_REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
FOODSHIELD_STORAGE_ENDPOINT=http://localhost:9000
FOODSHIELD_STORAGE_ACCESS_KEY=minioadmin
FOODSHIELD_STORAGE_SECRET_KEY=minioadmin
FOODSHIELD_STORAGE_BUCKET=foodshield-images
FOODSHIELD_STORAGE_REGION=us-east-1
FOODSHIELD_STORAGE_SECURE=false

# JWT
FOODSHIELD_JWT_SECRET_KEY=change-me-in-production
FOODSHIELD_JWT_ALGORITHM=HS256
FOODSHIELD_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
FOODSHIELD_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Engine
FOODSHIELD_AI_ENGINE_URL=http://ai-engine:8501
FOODSHIELD_MAX_UPLOAD_SIZE_MB=10
FOODSHIELD_ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# ---------------------------------------------------------------------------
# Ollama (Local LLM — recommended, free, private, no API key needed)
# ---------------------------------------------------------------------------
# URL of your locally running Ollama server
OLLAMA_BASE_URL=http://localhost:11434/v1
# Request timeout in seconds (increase for slow hardware)
OLLAMA_TIMEOUT=120
# Set to "false" to disable Ollama entirely and fall back to templates
OLLAMA_ENABLED=true

# LLM backend for inspection report generation
#   "ollama/llama3.1:8b"   — Ollama (recommended, default)
#   "ollama/mistral:7b"    — Alternative Ollama model
#   "gpt-4"                — OpenAI (requires OPENAI_API_KEY below)
#   "local/template"       — Offline template, no LLM
FOODSHIELD_LLM_MODEL=ollama/llama3.1:8b
FOODSHIELD_LLM_TEMPERATURE=0.3

# Ollama model for XAI natural-language explanation generation
#   Recommended lightweight options: llama3.2:3b, phi3.5:3.8b, gemma2:2b
FOODSHIELD_OLLAMA_XAI_MODEL=llama3.2:3b

# Ollama model for OCR label parsing fallback
#   Used when regex extracts fewer than 2 fields from label text
FOODSHIELD_OLLAMA_OCR_MODEL=llama3.2:3b

# Vision LLM augmentation (optional — needs GPU for best performance)
#   Set to "true" to enable second-opinion VLM cross-validation of CV results
#   Requires a vision-capable model pulled: ollama pull llava:7b
FOODSHIELD_VLM_ENABLED=false
FOODSHIELD_VLM_MODEL=llava:7b

# ---------------------------------------------------------------------------
# OpenAI (alternative to Ollama — requires paid API key)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
