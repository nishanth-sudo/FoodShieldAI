# vLLM Configuration
# Copy this file to vllm.env and fill in your values.
# Do NOT commit vllm.env to version control.

# Model to serve (must be a Hugging Face model ID or a local path)
MODEL_NAME=facebook/opt-125m

# Number of GPU devices for tensor parallelism (1 = single GPU)
TENSOR_PARALLEL_SIZE=1

# Fraction of GPU memory to reserve for the model (0.0 – 1.0)
GPU_MEMORY_UTILIZATION=0.8

# Maximum sequence length (tokens). Reduce if you hit OOM errors.
MAX_MODEL_LEN=2048

# Server bind settings (rarely need changing inside Docker)
HOST=0.0.0.0
PORT=8000
